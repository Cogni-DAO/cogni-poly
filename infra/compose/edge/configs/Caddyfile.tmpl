{
  log {
    level INFO
    format json
    output file /data/logs/caddy/caddy.log {
      roll_size 10MB
      roll_keep 7
      roll_keep_for 168h
    }
  }
}

# Redirect www to non-www (canonical domain)
www.{$DOMAIN} {
  redir https://{$DOMAIN}{uri} permanent
}

# ── cogni-poly is single-node → k3s NodePort 30100 ───────────────────────
# bug.5001: pre-PR #11 strip, this file carried separate operator / poly /
# resy site blocks with their own {$*_DOMAIN} keys. After the strip,
# POLY_DOMAIN + RESY_DOMAIN are empty in the deploy-infra .env writer, so
# those blocks rendered as bare `{` → Caddy parser reads them as a global
# block out of order → fatal config error → restart loop. Single-node
# fork has exactly one domain, exactly one upstream — collapse to one
# site block.
{$DOMAIN} {
  encode zstd gzip

  @public path /api/v1/public/*
  handle @public {
    reverse_proxy {$POLY_UPSTREAM:host.docker.internal:30100} {
      header_up X-Real-IP {remote_host}
      transport http {
        response_header_timeout 10s
      }
    }
  }

  reverse_proxy {$POLY_UPSTREAM:host.docker.internal:30100}

  log {
    format json
    output file /data/logs/caddy/access.log {
      roll_size 10MB
      roll_keep 7
      roll_keep_for 168h
    }
  }
}

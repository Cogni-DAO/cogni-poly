# .env.cogni.example — per-developer + per-tenant credentials for cogni-poly
#
# Copy to .env.cogni (gitignored) and fill with real values. The file is
# sourced ad-hoc by Cogni-DAO tooling (grafana-postgres-query.sh, the
# /contribute-to-cogni skill, paper-twin-diff.ts, etc.).
#
# Charter: work/charters/POLY_ALGO_TENANT_MATRIX.md governs which
# POLY_<ENV>_<ROLE>_* tenant blocks live here. Every matrix row in that
# charter MUST have a key block here (real values in .env.cogni, redacted
# placeholders in this .example).
#
# Key block shape (one per tenant role):
#   POLY_<ENV>_<ROLE>_API_KEY=cogni_ag_sk_v1_…
#   POLY_<ENV>_<ROLE>_USER_ID=<uuid>
#   POLY_<ENV>_<ROLE>_BILLING_ACCOUNT_ID=<uuid>
#   POLY_<ENV>_<ROLE>_TARGET_ID=<uuid>           # poly_copy_trade_targets.id row PK
#   POLY_<ENV>_<ROLE>_TARGET_WALLET=0x…          # the wallet being copy-traded
#   POLY_<ENV>_<ROLE>_CONFIG=<descriptive_slug>  # e.g. p80_max15_swisstony

# =========================================================================
# Cogni operator API keys (cross-env; used by /contribute-to-cogni + work-items API)
# Agent name: <your-handle>
# Use as: Authorization: Bearer $COGNI_API_KEY_<ENV>
# =========================================================================

# --- TEST (test.cognidao.org) — sandbox; not for real work tracking ---
COGNI_API_KEY_TEST=cogni_ag_sk_v1_REDACTED
COGNI_USER_ID_TEST=00000000-0000-0000-0000-000000000000
COGNI_BILLING_ACCOUNT_TEST=00000000-0000-0000-0000-000000000000

# --- PREVIEW (preview.cognidao.org) — usually unused for work-items ---
COGNI_API_KEY_PREVIEW=cogni_ag_sk_v1_REDACTED
COGNI_USER_ID_PREVIEW=00000000-0000-0000-0000-000000000000
COGNI_BILLING_ACCOUNT_PREVIEW=00000000-0000-0000-0000-000000000000

# --- PROD (cognidao.org) — REAL work tracking; treat as production ---
COGNI_API_KEY_PROD=cogni_ag_sk_v1_REDACTED
COGNI_USER_ID_PROD=00000000-0000-0000-0000-000000000000
COGNI_BILLING_ACCOUNT_PROD=00000000-0000-0000-0000-000000000000

# =========================================================================
# Notion (work-items mirror)
# =========================================================================
WORK_ITEMS_NOTION_TOKEN=ntn_REDACTED
WORK_ITEMS_NOTION_ROOT_URL=https://www.notion.so/<workspace>/<root-page>
WORK_ITEMS_NOTION_ROOT_PAGE_ID=00000000000000000000000000000000
WORK_ITEMS_NOTION_DATA_SOURCE_ID=00000000-0000-0000-0000-000000000000
WORK_ITEMS_NOTION_DATABASE_ID=00000000-0000-0000-0000-000000000000
WORK_ITEMS_NOTION_VERSION=2025-09-03

# =========================================================================
# Grafana (Loki + Postgres datasource queries)
# scripts/grafana-postgres-query.sh + scripts/loki-query.sh both source this
# =========================================================================
GRAFANA_URL=https://<your-org>.grafana.net/
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_REDACTED

# =========================================================================
# Polymarket per-tenant trading credentials (POLY_<ENV>_<ROLE>_*)
#
# These blocks correspond 1:1 to rows in work/charters/POLY_ALGO_TENANT_MATRIX.md.
# Add a new block here BEFORE adding a tenant to the matrix; matrix-without-key
# means no agent can drive the tenant from outside session-cookie HTTP.
# =========================================================================

# --- POLY_PROD_TENANT — derek's real live wallet ---
# Source of truth for production behavior. The charter pins this as the
# baseline that preview's `swiss-tps-control` paper-twin tracks.
POLY_PROD_TENANT_API_KEY=cogni_ag_sk_v1_REDACTED
POLY_PROD_TENANT_BILLING_ACCOUNT_ID=00000000-0000-0000-0000-000000000000

# --- POLY_PREVIEW_TRUST_TWIN — paper-twin of POLY_PROD_TENANT on preview ---
# Role: swiss-tps-control (per charter target preview matrix).
# Mode is dispatched by env (PAPER_ENFORCE_MODE=paper on preview); the
# target row's mode='live' is advisory metadata, not a dispatch hook.
POLY_PREVIEW_TRUST_TWIN_API_KEY=cogni_ag_sk_v1_REDACTED
POLY_PREVIEW_TRUST_TWIN_USER_ID=00000000-0000-0000-0000-000000000000
POLY_PREVIEW_TRUST_TWIN_BILLING_ACCOUNT_ID=00000000-0000-0000-0000-000000000000
POLY_PREVIEW_TRUST_TWIN_TARGET_ID=00000000-0000-0000-0000-000000000000
POLY_PREVIEW_TRUST_TWIN_TARGET_WALLET=0x0000000000000000000000000000000000000000
POLY_PREVIEW_TRUST_TWIN_CONFIG=p80_max15_swisstony

# --- POLY_PREVIEW_GAP_EXPERIMENT — position_gap variant of swisstony ---
# Role: swiss-gap-experiment (per charter target preview matrix).
# Pinned to sizing_policy_kind='position_gap' with the default target_scale.
# NOT YET REGISTERED — register via /contribute-to-cogni flow, then fill.
# POLY_PREVIEW_GAP_EXPERIMENT_API_KEY=cogni_ag_sk_v1_REDACTED
# POLY_PREVIEW_GAP_EXPERIMENT_USER_ID=
# POLY_PREVIEW_GAP_EXPERIMENT_BILLING_ACCOUNT_ID=
# POLY_PREVIEW_GAP_EXPERIMENT_TARGET_ID=
# POLY_PREVIEW_GAP_EXPERIMENT_TARGET_WALLET=0x204f72f35326db932158cba6adff0b9a1da95e14
# POLY_PREVIEW_GAP_EXPERIMENT_CONFIG=p80_max15_swisstony_position_gap

# --- POLY_PREVIEW_MINBET_FLOOR — min_bet lower-bound sanity row ---
# Role: swiss-minbet-floor (per charter target preview matrix).
# Pinned to sizing_policy_kind='min_bet' to mark the under-mirroring shape.
# NOT YET REGISTERED — register via /contribute-to-cogni flow, then fill.
# POLY_PREVIEW_MINBET_FLOOR_API_KEY=cogni_ag_sk_v1_REDACTED
# POLY_PREVIEW_MINBET_FLOOR_USER_ID=
# POLY_PREVIEW_MINBET_FLOOR_BILLING_ACCOUNT_ID=
# POLY_PREVIEW_MINBET_FLOOR_TARGET_ID=
# POLY_PREVIEW_MINBET_FLOOR_TARGET_WALLET=0x204f72f35326db932158cba6adff0b9a1da95e14
# POLY_PREVIEW_MINBET_FLOOR_CONFIG=p80_minbet_swisstony

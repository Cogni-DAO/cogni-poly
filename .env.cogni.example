# .env.cogni.example — copy to .env.cogni (gitignored) and fill in.
#
# Per-tenant matrix lives in work/charters/POLY_ALGO_TENANT_MATRIX.md.
# Every matrix row needs a 2-line POLY_<ENV>_<ROLE>_{API_KEY, BILLING_ACCOUNT_ID}
# block here. That's all `paper-twin-diff.ts` and the agent flow consume.

# Cogni operator API keys (one per env). Bearer auth for /api/v1/work + /agent.
COGNI_API_KEY_TEST=cogni_ag_sk_v1_REDACTED
COGNI_API_KEY_PREVIEW=cogni_ag_sk_v1_REDACTED
COGNI_API_KEY_PROD=cogni_ag_sk_v1_REDACTED

# Notion mirror (work items)
WORK_ITEMS_NOTION_TOKEN=ntn_REDACTED

# Grafana (Loki + Postgres datasource queries via scripts/*-query.sh)
GRAFANA_URL=https://<your-org>.grafana.net/
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_REDACTED

# --- Poly tenant matrix (see charter for purpose-per-tenant) ---

# PROD — derek's real live wallet. Baseline that preview twins track.
POLY_PROD_TENANT_API_KEY=cogni_ag_sk_v1_REDACTED
POLY_PROD_TENANT_BILLING_ACCOUNT_ID=00000000-0000-0000-0000-000000000000

# PREVIEW · trust-twin — paper-twin of PROD on legacy target_percentile_scaled.
POLY_PREVIEW_TRUST_TWIN_API_KEY=cogni_ag_sk_v1_REDACTED
POLY_PREVIEW_TRUST_TWIN_BILLING_ACCOUNT_ID=00000000-0000-0000-0000-000000000000

# CANDIDATE-A · validation — long-lived swisstony counterpart on cand-a; drives /validate-candidate.
POLY_CANDIDATE_A_VALIDATION_API_KEY=cogni_ag_sk_v1_REDACTED
POLY_CANDIDATE_A_VALIDATION_BILLING_ACCOUNT_ID=00000000-0000-0000-0000-000000000000

# PREVIEW · gap-experiment — position_gap variant of swisstony (NOT YET REGISTERED).
# POLY_PREVIEW_GAP_EXPERIMENT_API_KEY=cogni_ag_sk_v1_REDACTED
# POLY_PREVIEW_GAP_EXPERIMENT_BILLING_ACCOUNT_ID=

# PREVIEW · minbet-floor — min_bet lower-bound sanity row (NOT YET REGISTERED).
# POLY_PREVIEW_MINBET_FLOOR_API_KEY=cogni_ag_sk_v1_REDACTED
# POLY_PREVIEW_MINBET_FLOOR_BILLING_ACCOUNT_ID=
